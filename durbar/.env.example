# Copy to .env and fill in. Nothing here is committed.

# ── Provider ──────────────────────────────────────────────────────────────────
# deepseek | openrouter | compat
DURBAR_PROVIDER=deepseek

# deepseek (default)
DEEPSEEK_API_KEY=

# openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_REFERER=https://your-site.example
# OPENROUTER_TITLE=Durbar

# compat — any OpenAI-compatible endpoint
# DURBAR_BASE_URL=https://api.example.com/v1
# DURBAR_API_KEY=
# DURBAR_MODEL=

# Optional model overrides. Sensible defaults are applied per provider.
# DURBAR_MODEL=
# DURBAR_REASONING_MODEL=
# DURBAR_ROUTING_MODEL=

# ── Server ────────────────────────────────────────────────────────────────────
DURBAR_PORT=8787

# Absolute URL the dashboard calls for server work. Leave empty when the
# dashboard is served from the same origin as the server (the local/Docker
# case). Set it when the frontend is hosted separately — e.g. on Netlify or
# Vercel while the server runs on Fly.io.
DURBAR_PUBLIC_URL=

# Comma-separated origins allowed to call this server cross-origin. Leave empty
# for same-origin (local/Docker). Set it when the dashboard is hosted separately
# — e.g. https://your-dashboard.netlify.app
DURBAR_ALLOWED_ORIGINS=

# ── Storage ───────────────────────────────────────────────────────────────────
# One file holds the relational data and the full-text search index.
DURBAR_DB_PATH=./durbar.db
