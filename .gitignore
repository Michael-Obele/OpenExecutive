# `packages/mcp/node_modules` was committed by the `bun create tmcp` scaffold as an
# explicit file list (not a `node_modules/` rule), so new dev-only type packages
# appear as untracked noise. `bun install` restores these from the lockfile.
packages/mcp/node_modules/@types/
packages/mcp/node_modules/bun-types/
